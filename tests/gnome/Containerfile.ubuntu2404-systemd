# Ubuntu 24.04 with systemd as PID 1, for tests/gnome/run-systemd.sh (plan Task 11).
# The first RUN line is the same as in Containerfile.ubuntu2404, so the build
# reuses that layer. The image already has systemd, libpam-systemd and
# dbus-user-session (dependencies of gnome-shell). The test user "tester" has
# linger, so its user manager starts at boot. /var/log/journal makes the journal
# persistent: only a persistent journal has one file for each user, which
# "journalctl --user" reads.
FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      gnome-shell gjs gir1.2-soup-3.0 gir1.2-pango-1.0 dbus dconf-service \
      gsettings-desktop-schemas fonts-noto-core gnome-shell-extension-ubuntu-dock \
      yaru-theme-gnome-shell ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends \
      systemd systemd-sysv libpam-systemd dbus-user-session procps \
    && rm -rf /var/lib/apt/lists/* \
    && systemctl set-default multi-user.target \
    && useradd -m -u 2000 -s /bin/bash tester \
    && mkdir -p /var/lib/systemd/linger /var/log/journal \
    && touch /var/lib/systemd/linger/tester
