# The failure banner (spec 5.7): gnome-air-raid-map.service starts this unit when a
# run fails. updater/failed.sh only runs gsettings, so it cannot fail for the same
# reason as the updater, and it sets only the keys that have another value. The
# next good run puts the live map back. install.sh replaces the @...@ values.
[Unit]
Description=Air raid map wallpaper failure banner

[Service]
Type=oneshot
ExecStart=/bin/sh @APPDIR@/updater/failed.sh @GSETTINGS@ '@BANNER_URI@'
